# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (browser-safe) key. Legacy "anon" keys are deprecated by the end of 2026.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (service-role) key. SERVER ONLY.
# It bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Used for absolute links (e.g. nothing in this app currently emails a link, but keep it
# correct for deployments behind a proxy).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Organisation name printed on generated documents.
ORGANIZATION_NAME=ฝ่ายเทคโนโลยีสารสนเทศ (IT Department)

# Timezone used to turn stored UTC timestamps into Thai calendar dates.
APP_TIMEZONE=Asia/Bangkok

# ---------------------------------------------------------------------------
# PDF generation
# ---------------------------------------------------------------------------
# Private Supabase Storage bucket for generated PDFs.
PDF_STORAGE_BUCKET=generated-pdfs

# Optional: path to a single Thai TTF. Defaults to the bundled Noto Sans Thai files in
# src/lib/pdf/assets (fetch them with: npm run fonts:fetch).
# PDF_FONT_PATH=

# Optional: Chromium binary. Leave empty to use the one installed by puppeteer.
# In the Docker image this is set to the system chromium.
# PDF_CHROMIUM_EXECUTABLE_PATH=

# Hard limit for a single PDF render, in milliseconds.
PDF_BROWSER_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Local Supabase CLI only (never used by the deployed app)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
